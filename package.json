{
  "name": "@ahpd/web",
  "version": "0.3.1",
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "description": "A web UI for an AHP server, as an ahpd plugin or on its own with ahpw serve",
  "keywords": [
    "ahp",
    "agent-host-protocol",
    "ahpd",
    "plugin",
    "web",
    "admin"
  ],
  "author": "Luiz Fernando Softov <lfs@softov.dev>",
  "license": "MIT",
  "homepage": "https://github.com/softov/ahpw#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/softov/ahpw.git"
  },
  "bugs": {
    "url": "https://github.com/softov/ahpw/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "ahpw": "./dist/cli/main.js"
  },
  "main": "./dist/plugin/index.js",
  "types": "./dist/plugin/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/plugin/index.d.ts",
      "default": "./dist/plugin/index.js"
    },
    "./embed": {
      "types": "./dist/embed/index.d.ts",
      "default": "./dist/embed/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && tsc -p tsconfig.plugin.json && tsc -p tsconfig.cli.json && tsc -p tsconfig.embed.json && chmod +x dist/cli/main.js",
    "typecheck": "tsc -b",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@ahpd/sdk": ">=0.9"
  },
  "peerDependenciesMeta": {
    "@ahpd/sdk": {
      "optional": true
    }
  },
  "devDependencies": {
    "@ahpd/sdk": "^0.9.0",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-go": "^6.0.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-java": "^6.0.2",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-php": "^6.0.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.13.1",
    "@codemirror/legacy-modes": "^6.5.5",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@lezer/highlight": "^1.2.5",
    "@microsoft/agent-host-protocol": "^1.0.0",
    "@softov/scena": "^0.5.5",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.5",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^5.9.3",
    "vite": "^8.2.1",
    "vitest": "^4.1.0"
  },
  "ahpd": {
    "entry": "./dist/plugin/index.js",
    "title": "Web"
  },
  "dependencies": {
    "@cofold/commands": "^0.3.0",
    "@cofold/config": "^0.3.1",
    "@cofold/remote": "^0.5.0",
    "@cofold/terminal": "^0.3.0"
  }
}
